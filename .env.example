# 复制这个文件为 .env，然后把 key 换成你自己的。
# 注意：.env 已经在 .gitignore 里，不要把它提交到 GitHub。

# 阿里云百炼（通义千问 Qwen-VL）控制台：https://bailian.console.aliyun.com/
# 新用户有免费额度，开通后在这里拿 key。
LLM_API_KEY=sk-在这里填你的key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 视觉理解模型，三选一：
#   qwen3-vl-plus    精度和价格平衡，推荐（默认）
#   qwen3-vl-flash   更便宜更快，估算会粗一点
#   qwen-vl-max      更准，也更贵
LLM_MODEL=qwen3-vl-plus

# 请求是否走系统代理 / 代理环境变量。默认 0（不走）。
#
# 为什么默认关闭：httpx（openai 库底层）默认会读取 Windows 注册表里的系统代理。
# 如果你开着 VPN / 代理 / 网络加速器，请求会被导到境外节点，
# 而百炼是国内服务，TLS 会被中间层掐断，报 "Connection error."
# 或 "UNEXPECTED_EOF_WHILE_READING"。
#
# 只有当你的网络必须经代理才能访问外网时，才改成 1。
LLM_USE_PROXY=0

# ---- 想换成别的模型就改下面这几行 ----
# 智谱 GLM-4V：
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_MODEL=glm-4v-plus
#
# OpenAI：
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
